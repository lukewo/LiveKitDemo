    <RootNamespace>LiveKitDemo.Droid</RootNamespace>
    <AssemblyName>LiveKitDemo.Android</AssemblyName>
    <Deterministic>True</Deterministic>
    <AndroidApplication>True</AndroidApplication>
    <AndroidResgenFile>Resources\Resource.designer.cs</AndroidResgenFile>
    <AndroidResgenClass>Resource</AndroidResgenClass>
    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
    <MonoAndroidResourcePrefix>Resources</MonoAndroidResourcePrefix>
    <MonoAndroidAssetsPrefix>Assets</MonoAndroidAssetsPrefix>
    <AndroidUseLatestPlatformSdk>false</AndroidUseLatestPlatformSdk>
    <TargetFrameworkVersion>v13.0</TargetFrameworkVersion>
    <AndroidEnableSGenConcurrent>true</AndroidEnableSGenConcurrent>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <AndroidHttpClientHandlerType>Xamarin.Android.Net.AndroidClientHandler</AndroidHttpClientHandlerType>
    <!-- LiveKit + WebRTC + Kotlin + protobuf exceed the 64K method limit. -->
    <AndroidEnableMultiDex>true</AndroidEnableMultiDex>
    <AndroidDexTool>d8</AndroidDexTool>
    <!--
      The r8.jar bundled with Xamarin.Android 13.2 (R8 3.3.75, 2021) crashes with an
      internal NullPointerException dexing JNA 5.19 (a LiveKit dependency). Use the
      newer D8/R8 from the Android SDK build-tools instead. Needs JDK 11+.
    -->
    <_LkBuildToolsD8>$(AndroidSdkDirectory)\build-tools\36.0.0\lib\d8.jar</_LkBuildToolsD8>
    <_LkBuildToolsD8 Condition=" '$(AndroidSdkDirectory)' == '' ">$(MSBuildProgramFiles32)\Android\android-sdk\build-tools\36.0.0\lib\d8.jar</_LkBuildToolsD8>
    <AndroidR8JarPath Condition=" Exists('$(_LkBuildToolsD8)') ">$(_LkBuildToolsD8)</AndroidR8JarPath>
    <!-- Merge library manifests (LiveKit/audioswitch permissions and components). -->
    <AndroidManifestMerger>manifestmerger.jar</AndroidManifestMerger>
    <NuGetPackageImportStamp>
    </NuGetPackageImportStamp>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
